# Required for Milestone 2 LLM adjudication (scripts/detect_changes.py).
# The change-detection LLM call always runs against Hugging Face Inference
# Providers; it is never mocked outside of tests.
HF_TOKEN=

# Optional overrides for the adjudication model/provider and the local
# alignment model. Defaults match Milestone 2's spec if left unset.
CHANGE_LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
CHANGE_LLM_PROVIDER=novita
CHANGE_ALIGN_MODEL=sentence-transformers/all-mpnet-base-v2
