<rdf:Description rdf:about=""  xmlns:dc="http://purl.org/dc/elements/1.1/">
<dc:title><rdf:Alt><rdf:li xml:lang="x-default">Sleep Studies â€“ Commercial and Individual Exchange Medical Policy</rdf:li></rdf:Alt></dc:title><dc:creator><rdf:Seq><rdf:li>UnitedHealthcare</rdf:li></rdf:Seq></dc:creator><dc:description><rdf:Alt><rdf:li xml:lang="x-default">Effective Date: 07.01.2026 â€“ This policy addresses home sleep apnea testing, attended full-channel polysomnography performed in a healthcare facility or laboratory setting, daytime sleep studies, attended PAP titration and attended repeat testing. Applicable Procedure Codes: 95782, 95783, 95800, 95801, 95803, 95805, 95806, 95807, 95808, 95810, 95811, G0398, G0399, G0400.</rdf:li></rdf:Alt></dc:description></rdf:Description>
